[package]
name = "heffs-i3-toolkit"
version = "0.1.0"
description = "Visual config toolkit for i3, Polybar, i3lock-color, rofi and LightDM"
authors = ["Brad Heffernan"]
edition = "2021"

[lib]
name = "heffs_i3_toolkit_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
dirs = "5"
chrono = "0.4"
