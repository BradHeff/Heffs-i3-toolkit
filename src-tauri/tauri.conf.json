{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heffs i3 toolkit",
  "version": "0.1.0",
  "identifier": "ai.heffernan.heffs-i3-toolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heffs i3 toolkit",
        "width": 1230,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "rpm",
    "icon": [
      "icons/icon.png"
    ]
  }
}
